{
    "name": "jaylordibe/laravel-resource-generator",
    "description": "A resource generator for Laravel projects.",
    "type": "library",
    "keywords": ["laravel", "generator", "scaffold", "crud", "artisan"],
    "license": "MIT",
    "authors": [
        {
            "name": "JayLordIbe",
            "email": "developer.jayibe@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/jaylordibe/laravel-resource-generator/issues",
        "source": "https://github.com/jaylordibe/laravel-resource-generator"
    },
    "require": {
        "php": "^8.3",
        "illuminate/support": "^13.0",
        "illuminate/console": "^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "JayLordIbe\\LaravelResourceGenerator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JayLordIbe\\LaravelResourceGenerator\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "JayLordIbe\\LaravelResourceGenerator\\Providers\\LaravelResourceGeneratorServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
